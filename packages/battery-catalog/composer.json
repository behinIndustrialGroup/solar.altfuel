{
    "name": "behin/battery-catalog",
    "description": "Battery catalog management package for solar energy storage systems",
    "type": "library",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "BatteryCatalog\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BatteryCatalog\\BatteryCatalogServiceProvider"
            ]
        }
    }
}
